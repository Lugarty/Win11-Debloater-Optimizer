## Ignore Visual Studio temporary files, build results, and user-specific files.

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/

# Visual Studio cache/options directory
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider / VS Code
.idea/
.vscode/

# Arquivos temporários do Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# O próprio executável final (você deve distribuir via Releases, não no código-fonte)
*.exe
*.dll